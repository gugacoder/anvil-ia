# Template — .env.production.example  (raiz do repo)
#
# Tres categorias misturadas (sao tres consumidores diferentes):
#   1. Runtime do app           — usado por docker-compose / containers
#   2. Build do frontend        — usado pelo Vite no build
#   3. Deploy ops (skill)       — usado SO pelos scripts da skill processa-deploy
#
# NAO use comentarios inline depois de `=` (vira parte do valor — ver gotcha 12).

# ─────────────────────────────────────────────────────────────
# RUNTIME DO APP (consumido pelo docker-compose / containers)
# ─────────────────────────────────────────────────────────────

ENVIRONMENT=production
PROJECT=<PROJECT>

# Dominio publico (a confirmar com infra Processa)
PUBLIC_DOMAIN=<PROJECT>.processa.info

# Porta local que o Apache externo proxia → Caddy interno
# Coordenar com infra. Conferir livre com: ss -ltn no host
PUBLIC_PORT=8080

# Portas internas (Caddy fala com elas)
FRONTEND_PORT=4001
BACKEND_PORT=4000

# Hosts internos (em prod = nomes dos containers)
PROXY_FRONTEND_HOST=frontend
PROXY_BACKEND_HOST=backend

# Imagens publicadas (registry)
# IMAGE_REGISTRY e pre-populado pelo bootstrap-project.sh; senao pegue do
# group var DOCKER_REGISTRY_URL (sem o https://)
IMAGE_REGISTRY=
IMAGE_TAG=<BRANCH>-latest

# Autenticacao JWT (gerar: openssl rand -base64 32)
JWT_SECRET=

# PostgreSQL (gerar password: openssl rand -base64 24)
POSTGRES_USER=<PROJECT>
POSTGRES_PASSWORD=
POSTGRES_DB=<PROJECT>
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backbone (agentic-backbone) — chat via openclaude-chat
# AMBAS sao lidas em import-time pelo backend; vazio = backend NAO sobe.
# Pra primeiro deploy sem chat, use placeholders e ignore feature de AI.
BACKBONE_URL=
BACKBONE_API_KEY=

# ─────────────────────────────────────────────────────────────
# BUILD DO FRONTEND (compile-time, vai pro bundle JS)
# ─────────────────────────────────────────────────────────────

VITE_COLOR_THEME=blue
VITE_AGENT_ID=system.<PROJECT>

# ─────────────────────────────────────────────────────────────
# DEPLOY OPS (usado SO pelos scripts da skill processa-deploy)
# Nao passa pra app — apenas pra scripts locais que falam com GitLab API
# ─────────────────────────────────────────────────────────────

# PAT pessoal — crie em GitLab Processa → Profile → Access Tokens
# Scopes minimos: api, read_repository
GITLAB_ACCESS_TOKEN=

# URL do GitLab Processa. Default OK; ajuste se DNS local nao resolver
# (ex: http://172.27.0.194 com entry no hosts file)
GITLAB_URL=http://gitlab.processa.info
