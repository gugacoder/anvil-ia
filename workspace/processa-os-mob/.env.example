PORT=5640
JWT_SECRET=troque-isto-em-prod
# ANVIL_CWD opcional — sobrescreve a raiz do repo descoberta automaticamente
# pelo bridge AI. Default: raiz do proprio repo anvil (path relativo ao server).
# ANVIL_CWD=
STORAGE_DIR=./storage
PUBLIC_PATH=/so

# =============================================================================
# Layouts disponiveis e ordem (primeiro = default). Lidas pelo Vite (shell).
# Formato CSV: "windowed" e/ou "workspace".
#   - 1 so item = trava (user nao pode trocar via Configuracoes).
#   - 2 itens = ambos disponiveis, primeiro = default.
# Linhas comentadas usam o default de codigo:
#   tablet  = workspace,windowed
#   desktop = windowed,workspace
#   tv      = windowed,workspace
# =============================================================================
# VITE_LAYOUT_TABLET=workspace,windowed    # tablet grande (820-1199px)
# VITE_LAYOUT_DESKTOP=windowed,workspace   # desktop (1200-1919px)
# VITE_LAYOUT_TV=windowed,workspace        # tv (>=1920px)
