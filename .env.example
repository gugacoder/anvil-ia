# Credenciais para acesso a recursos da Processa.
# Copie este arquivo para .env e preencha os valores reais.
# .env não é versionado (ver .gitignore).

# === Rede Processa (share SMB, etc) ===
# Usuário de domínio. Formato: DOMINIO\usuario
PROCESSA_NET_USER=processa\seu-usuario
PROCESSA_NET_PASS=sua-senha

# === Banco DBdirector (SQL Server) ===
DIRECTOR_DB_HOST=
DIRECTOR_DB_INSTANCE=
DIRECTOR_DB_NAME=DBdirector
DIRECTOR_DB_USER=
DIRECTOR_DB_PASS=
DIRECTOR_DB_TRUST_CERT=true

# Base do AppBuilder
APPBUILDER_DB_HOST=
APPBUILDER_DB_INSTANCE=
APPBUILDER_DB_NAME=
APPBUILDER_DB_USER=
APPBUILDER_DB_PASS=
APPBUILDER_DB_TRUST_CERT=true

# Credenciais do Gitlab
GITLAB_URL=
GITLAB_ACCESS_TOKEN=
